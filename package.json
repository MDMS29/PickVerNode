{
  "name": "PickVerNode",
  "displayName": "PickVerNode",
  "description": "%extension.description%",
  "version": "0.5.0",
  "publisher": "MoiDev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pickvernode.pick",
        "title": "%cmd.pick%"
      },
      {
        "command": "pickvernode.install",
        "title": "%cmd.install%"
      },
      {
        "command": "pickvernode.uninstall",
        "title": "%cmd.uninstall%"
      },
      {
        "command": "pickvernode.useRequired",
        "title": "%cmd.useRequired%"
      },
      {
        "command": "pickvernode.writeNvmrc",
        "title": "%cmd.writeNvmrc%"
      },
      {
        "command": "pickvernode.openWalkthrough",
        "title": "%cmd.openWalkthrough%"
      },
      {
        "command": "pickvernode.revealBinFolder",
        "title": "%cmd.revealBinFolder%"
      },
      {
        "command": "pickvernode.enableCorepack",
        "title": "%cmd.enableCorepack%"
      },
      {
        "command": "pickvernode.checkFolders",
        "title": "%cmd.checkFolders%"
      },
      {
        "command": "pickvernode.copyBinPath",
        "title": "%cmd.copyBinPath%"
      },
      {
        "command": "pickvernode.refresh",
        "title": "%cmd.refresh%"
      },
      {
        "command": "pickvernode.selectProvider",
        "title": "%cmd.selectProvider%"
      }
    ],
    "terminalProfiles": [
      {
        "id": "pickvernode.terminal",
        "title": "%terminalProfile.title%",
        "icon": "versions"
      }
    ],
    "walkthroughs": [
      {
        "id": "pickvernode.setup",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "pickvernode.step.manager",
            "title": "%walkthrough.manager.title%",
            "description": "%walkthrough.manager.description%",
            "media": {
              "svg": "images/walkthrough/managers.svg",
              "altText": "%walkthrough.manager.alt%"
            },
            "completionEvents": [
              "onCommand:pickvernode.selectProvider"
            ]
          },
          {
            "id": "pickvernode.step.switch",
            "title": "%walkthrough.switch.title%",
            "description": "%walkthrough.switch.description%",
            "media": {
              "svg": "images/walkthrough/switch.svg",
              "altText": "%walkthrough.switch.alt%"
            },
            "completionEvents": [
              "onCommand:pickvernode.pick"
            ]
          },
          {
            "id": "pickvernode.step.nvmrc",
            "title": "%walkthrough.nvmrc.title%",
            "description": "%walkthrough.nvmrc.description%",
            "media": {
              "svg": "images/walkthrough/nvmrc.svg",
              "altText": "%walkthrough.nvmrc.alt%"
            },
            "completionEvents": [
              "onCommand:pickvernode.writeNvmrc"
            ]
          },
          {
            "id": "pickvernode.step.mismatch",
            "title": "%walkthrough.mismatch.title%",
            "description": "%walkthrough.mismatch.description%",
            "media": {
              "svg": "images/walkthrough/mismatch.svg",
              "altText": "%walkthrough.mismatch.alt%"
            },
            "completionEvents": [
              "onCommand:pickvernode.useRequired",
              "onSettingChanged:pickvernode.checkRequiredVersion"
            ]
          },
          {
            "id": "pickvernode.step.uac",
            "title": "%walkthrough.uac.title%",
            "description": "%walkthrough.uac.description%",
            "when": "isWindows",
            "media": {
              "svg": "images/walkthrough/managers.svg",
              "altText": "%walkthrough.uac.alt%"
            },
            "completionEvents": [
              "onSettingChanged:pickvernode.elevate"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "PickVerNode",
      "properties": {
        "pickvernode.provider": {
          "type": "string",
          "enum": [
            "auto",
            "nvm-windows",
            "nvm",
            "fnm",
            "volta",
            "asdf"
          ],
          "default": "auto",
          "description": "%cfg.provider%"
        },
        "pickvernode.updateTerminalEnv": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.updateTerminalEnv%"
        },
        "pickvernode.nvmPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.nvmPath%"
        },
        "pickvernode.elevate": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.elevate%"
        },
        "pickvernode.autoWriteNvmrc": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.autoWriteNvmrc%"
        },
        "pickvernode.nvmrcPrefixV": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.nvmrcPrefixV%"
        },
        "pickvernode.pollSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "%cfg.pollSeconds%"
        },
        "pickvernode.checkRequiredVersion": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.checkRequiredVersion%"
        },
        "pickvernode.notifyRequiredVersion": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notifyRequiredVersion%"
        },
        "pickvernode.warnEndOfLife": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.warnEndOfLife%"
        },
        "pickvernode.notifyEndOfLife": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notifyEndOfLife%"
        },
        "pickvernode.showAvailableVersions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.showAvailableVersions%"
        },
        "pickvernode.telemetry": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.telemetry%"
        }
      }
    }
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "keywords": [
    "node",
    "nodejs",
    "node version",
    "switch node version",
    "node version manager",
    "nvm",
    "nvm-windows",
    "fnm",
    "volta",
    "asdf",
    "nvmrc",
    "status bar",
    "version switcher",
    "toolchain"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MDMS29/PickVerNode.git"
  },
  "bugs": {
    "url": "https://github.com/MDMS29/PickVerNode/issues"
  },
  "scripts": {
    "lint": "eslint src test",
    "test": "vscode-test",
    "icon": "node scripts/make-icon.js",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^10.5.0",
    "globals": "^17.0.0",
    "ovsx": "^1.2.0"
  },
  "homepage": "https://github.com/MDMS29/PickVerNode#readme",
  "sponsor": {
    "url": "https://github.com/sponsors/MDMS29"
  },
  "qna": "https://github.com/MDMS29/PickVerNode/issues",
  "l10n": "./l10n"
}
